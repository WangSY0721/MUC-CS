module Timer(reset,clk,start,data_in,counter,mystate,ring,out1,out2);

input clk,reset,start;
input [7:0]data_in;

output reg [7:0]counter;
output reg [1:0]mystate;
output reg ring;
output reg [6:0]out1,out2;

reg [3:0] tcounter1,tcounter2;
reg [1:0]state;
parameter [1:0] S0=0,S1=1,S2=2,S3=3;

always@(posedge clk)
begin
	if(!reset)
		begin
			if(!start)
				state<=S0;
		end
	else
	case(state)
		S0:
			if(start)
				state<=S1;
			else
				state<=S0;
		S1:
			if(start)
				state<=S1;
			else
				state<=S2;
		S2:
			if(counter==1)
				state<=S3;
			else
				state<=S2;
		S3:
			if(counter!=1)
				state<=S3;
			else
				state<=S0;
	endcase
	mystate=state;	
end
always@(posedge clk)
begin
	case(state)
	S0:
		begin
			ring<=0;
			counter<=8'b00000000;
		end
	S1:
		counter<=data_in;
	S2:
		if(counter==1)
		begin
			counter<=8'b00001000;
			ring<=1;
		end
		else
			counter<=counter-1;
	S3:
		counter<=counter-1;
	endcase
end
always@(counter)
begin
	tcounter1<=counter[3:0];
	tcounter2<=counter[7:4];
end
always@(tcounter1)
begin
	case(tcounter1)
				4'b0000: out1 = 7'b1000000;
				4'b0001: out1 = 7'b1111001;
				4'b0010: out1 = 7'b0100100;
				4'b0011: out1 = 7'b0110000;
				4'b0100: out1 = 7'b0011001;
				4'b0101: out1 = 7'b0010010;
				4'b0110: out1 = 7'b0000010;
				4'b0111: out1 = 7'b1111000;
				4'b1000: out1 = 7'b0000000;
				4'b1001: out1 = 7'b0010000;
				
				4'b1010: out1 = 7'b0001000;
				4'b1011: out1 = 7'b0000011;
				4'b1100: out1 = 7'b1000110;
				4'b1101: out1 = 7'b0100001;
				4'b1110: out1 = 7'b0000110;
				4'b1111: out1 = 7'b0001110;
			default : out1 = 7'b1111111;
			endcase 
end
always@(tcounter2)
begin
	case(tcounter2)
				4'b0000: out2 = 7'b1000000;
				4'b0001: out2 = 7'b1111001;
				4'b0010: out2 = 7'b0100100;
				4'b0011: out2 = 7'b0110000;
				4'b0100: out2 = 7'b0011001;
				4'b0101: out2 = 7'b0010010;
				4'b0110: out2 = 7'b0000010;
				4'b0111: out2 = 7'b1111000;
				4'b1000: out2 = 7'b0000000;
				4'b1001: out2 = 7'b0010000;
				
				4'b1010: out2 = 7'b0001000;
				4'b1011: out2 = 7'b0000011;
				4'b1100: out2 = 7'b1000110;
				4'b1101: out2 = 7'b0100001;
				4'b1110: out2 = 7'b0000110;
				4'b1111: out2 = 7'b0001110;
			default : out2 = 7'b1111111;
			endcase 
end
endmodule