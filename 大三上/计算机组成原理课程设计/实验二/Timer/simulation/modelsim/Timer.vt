// Verilog Test Bench template for design : Timer
// 
// Simulation tool : ModelSim-Altera (Verilog)
// 

`timescale 1 ns/ 1 ps
module Timer_vlg_tst();
// constants                                           
// general purpose registers
reg eachvec;
// test vector input registers
reg clk;
reg [7:0] data_in;
reg reset;
reg start;
// wires                                               
wire [7:0]  counter;
wire [1:0]  mystate;

// assign statements (if any)                          
Timer i1 (
// port map - connection between master ports and signals/registers   
	.clk(clk),
	.counter(counter),
	.data_in(data_in),
	.mystate(mystate),
	.reset(reset),
	.start(start)
);
initial                                                
begin                                                                         
	clk=0;
	reset=0;
	start=0;
	data_in=8'hF;
	#30 reset=1;
	#10 start=1;
	#20 start=0;                                                                                                                                                 
$display("Running testbench");                       
end                                                    
always
	                                                               
begin  
    #10 clk=~clk;                                                                                         
end                                                    
endmodule
