module Multiplier(clk,reset,start,x,y,p,temp,mystate,done);

input clk,reset,start;
input [3:0]x,y;

output reg[8:0]p;		//9位的部分积
output reg[2:0]mystate;
output reg done;
output reg [4:0]temp;//定义变量

reg [3:0]rx,ry;
reg [2:0] state;
parameter [2:0]S0=0,S1=1,S2=2,S3=3,S4=4;

//当reset=1且start=0时，给与初始状态，reset具有最高级别的权力
always@(posedge clk)
begin
	if(reset)
	begin
		if(!start)
			state<=S0;
	end
	
	else
	begin
		case(state)
			S0:
			//当start=1时才进入状态1
				if(start)
					state<=S1;
				else	
					state<=S0;
			S1:
			//当start=0才进入状态2
				if(start)
					state<=S1;	
				else
					state<=S2;
			S2:
				state<=S3;
			S3:
				state<=S4;
			S4:
				if(start)
					state<=S0;
				else
					state<=S4;
		endcase
	end
	mystate=state;
end

always@(state)
begin
	case(state)
	S0:
		begin
			//rx保存被乘数
			rx=x;
			ry=y;
			temp=5'b00000;
			p={5'b00000,y};
			done=0;
		end
	S1:
		begin
			if(p[0]==1)
				temp=p[8:4]+{1'b0,rx};
			else
				temp=p[8:4];
				
			p={1'b0,temp,p[3:1]};
		end
	S2:
		begin
			if(p[0]==1)
				temp=p[8:4]+{1'b0,rx};
			else
				temp=p[8:4];
				
			p={1'b0,temp,p[3:1]};
		end
	S3:
		begin
			if(p[0]==1)
				temp=p[8:4]+{1'b0,rx};
			else
				temp=p[8:4];
			//部分积的最后结果的第一位一定是0
			p={1'b0,temp,p[3:1]};
		end
	S4:
		begin
			if(p[0]==1)
				temp=p[8:4]+{1'b0,rx};
			else
				temp=p[8:4];
			//部分积的最后结果的第一位一定是0
			p={1'b0,temp,p[3:1]};
			done=1;
		end
	endcase
	
end
endmodule