transcript on
if {[file exists rtl_work]} {
	vdel -lib rtl_work -all
}
vlib rtl_work
vmap work rtl_work

vlog -vlog01compat -work work +incdir+D:/Quartus/lab1 {D:/Quartus/lab1/ALU_74181.v}

vlog -vlog01compat -work work +incdir+D:/Quartus/lab1/simulation/modelsim {D:/Quartus/lab1/simulation/modelsim/ALU_74181.vt}

vsim -t 1ps -L altera_ver -L lpm_ver -L sgate_ver -L altera_mf_ver -L altera_lnsim_ver -L cycloneive_ver -L rtl_work -L work -voptargs="+acc"  ALU_74181_vlg_tst

add wave *
view structure
view signals
run 1000 ns
