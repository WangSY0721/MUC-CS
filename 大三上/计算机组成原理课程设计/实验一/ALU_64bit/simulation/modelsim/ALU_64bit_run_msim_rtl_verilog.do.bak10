transcript on
if {[file exists rtl_work]} {
	vdel -lib rtl_work -all
}
vlib rtl_work
vmap work rtl_work

vlog -vlog01compat -work work +incdir+D:/Quartus/ALU_64bit {D:/Quartus/ALU_64bit/ALU_64bit.v}
vlog -vlog01compat -work work +incdir+D:/Quartus/ALU_74182 {D:/Quartus/ALU_74182/ALU_74182.v}
vlog -vlog01compat -work work +incdir+D:/Quartus/ALU_74181 {D:/Quartus/ALU_74181/ALU_74181.v}
vlog -vlog01compat -work work +incdir+D:/Quartus/ALU_16bit {D:/Quartus/ALU_16bit/ALU_16bit.v}

vlog -vlog01compat -work work +incdir+D:/Quartus/ALU_64bit/simulation/modelsim {D:/Quartus/ALU_64bit/simulation/modelsim/ALU_64bit.vt}

vsim -t 1ps -L altera_ver -L lpm_ver -L sgate_ver -L altera_mf_ver -L altera_lnsim_ver -L cycloneive_ver -L rtl_work -L work -voptargs="+acc"  ALU_64bit_vlg_tst

add wave *
view structure
view signals
run 1000 ns
