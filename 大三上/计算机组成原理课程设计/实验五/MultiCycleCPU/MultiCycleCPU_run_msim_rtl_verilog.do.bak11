transcript on
if {[file exists rtl_work]} {
	vdel -lib rtl_work -all
}
vlib rtl_work
vmap work rtl_work

vlog -vlog01compat -work work +incdir+D:/20241127/MultiCycleCPU {D:/20241127/MultiCycleCPU/MultiCycleCPU.v}
vlog -vlog01compat -work work +incdir+D:/20241127/MultiCycleCPU {D:/20241127/MultiCycleCPU/div_20.v}
vlog -vlog01compat -work work +incdir+D:/20241127/MultiCycleCPU {D:/20241127/MultiCycleCPU/SignZeroExtend.v}
vlog -vlog01compat -work work +incdir+D:/20241127/MultiCycleCPU {D:/20241127/MultiCycleCPU/show.v}
vlog -vlog01compat -work work +incdir+D:/20241127/MultiCycleCPU {D:/20241127/MultiCycleCPU/RegisterFile.v}
vlog -vlog01compat -work work +incdir+D:/20241127/MultiCycleCPU {D:/20241127/MultiCycleCPU/PCAddr.v}
vlog -vlog01compat -work work +incdir+D:/20241127/MultiCycleCPU {D:/20241127/MultiCycleCPU/PC.v}
vlog -vlog01compat -work work +incdir+D:/20241127/MultiCycleCPU {D:/20241127/MultiCycleCPU/InstructionCut.v}
vlog -vlog01compat -work work +incdir+D:/20241127/MultiCycleCPU {D:/20241127/MultiCycleCPU/ControlUnit.v}
vlog -vlog01compat -work work +incdir+D:/20241127/MultiCycleCPU {D:/20241127/MultiCycleCPU/ALU.v}
vlog -vlog01compat -work work +incdir+D:/20241127/MultiCycleCPU {D:/20241127/MultiCycleCPU/CLKmode.v}
vlog -vlog01compat -work work +incdir+D:/20241127/MultiCycleCPU {D:/20241127/MultiCycleCPU/IO.v}
vlog -vlog01compat -work work +incdir+D:/20241127/MultiCycleCPU {D:/20241127/MultiCycleCPU/totalmem.v}

vlog -vlog01compat -work work +incdir+D:/20241127/MultiCycleCPU/simulation/modelsim0 {D:/20241127/MultiCycleCPU/simulation/modelsim0/MultiCycleCPU.vt}

vsim -t 1ps -L altera_ver -L lpm_ver -L sgate_ver -L altera_mf_ver -L altera_lnsim_ver -L cyclonev_ver -L cyclonev_hssi_ver -L cyclonev_pcie_hip_ver -L rtl_work -L work -voptargs="+acc"  MultiCycleCPU_vlg_tst

add wave *
view structure
view signals
run 2000 ps
