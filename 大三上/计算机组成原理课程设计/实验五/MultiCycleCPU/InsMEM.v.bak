`timescale 1ns / 1ps
//ROM
//instruction memory???????
module InsMEM(
input [31:0] IAddr,
input InsMemRW,
input [3:0] x,		//?????'0,????????????????????????
output reg[31:0] IDataOut
);
reg [7:0] rom[255:0]; // ????????????reg???,?????????????????28?????????????2????
//????????????rom????????????????
initial
begin
	//$readmemb("C:/Users/20678/Documents/Quartus10/quartus/jizu/2019computer/CPU-MUC1/rom.txt", rom);
end
//??????
always@(IAddr or InsMemRW)
begin
	//????
	//$readmemb("C:/Users/20678/Documents/Quartus10/quartus/jizu/2019computer/CPU-MUC1/rom.txt", rom);
	if(InsMemRW)
	begin
	rom[0]=8'b00100000;
	rom[1]=8'b00000010;
	rom[2]=8'b00000000;
	
	//rom[3]=8'b00001010;
	rom[3]={{4{1'b0}},x};
	
	rom[4]=8'b00100000;
	rom[5]=8'b00000001;
	rom[6]=8'b00000000;
	rom[7]={{4{1'b0}},x};
	
	rom[8]=8'b00100000;
	rom[9]=8'b00000010;
	rom[10]=8'b00000000;
	rom[11]=8'b00000001;
	rom[12]=8'b00100000;
	rom[13]=8'b00000011;
	rom[14]=8'b00000000;
	rom[15]=8'b00000001;
	rom[16]=8'b00000000;
	rom[17]=8'b00100010;
	rom[18]=8'b00000000;
	rom[19]=8'b00011000;
	rom[20]=8'b00000000;
	rom[21]=8'b00000000;
	rom[22]=8'b00100000;
	rom[23]=8'b00010010;
	rom[24]=8'b00000000;
	rom[25]=8'b00000100;
	rom[26]=8'b00010000;
	rom[27]=8'b00100000;
	rom[28]=8'b00000000;
	rom[29]=8'b00100011;
	rom[30]=8'b00001000;
	rom[31]=8'b00100010;
	
	rom[32]=8'b00010100;
	rom[33]=8'b00100011;
	rom[34]=8'b11111111;
	rom[35]=8'b11111011;
	
	rom[36]=8'b11111100;
	rom[37]=8'b00000000;
	rom[38]=8'b00000000;
	rom[39]=8'b00000000;
		IDataOut[7:0] = rom[IAddr + 3];
		IDataOut[15:8] = rom[IAddr + 2];
		IDataOut[23:16] = rom[IAddr + 1];
		IDataOut[31:24] = rom[IAddr];
		
	end
	//$display( "iaddr: %d insmemrw: %d inst; %d ,lAddr, InsMemRW, IDataOut);

end
endmodule
