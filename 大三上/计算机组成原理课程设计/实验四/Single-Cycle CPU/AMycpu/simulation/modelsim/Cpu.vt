`timescale 1 ns/ 1 ps
module Cpu_vlg_tst();
// constants                                           
// general purpose registers
reg eachvec;
// test vector input registers
reg [7:0] RandomNumber;
reg clk;
reg myreset;
reg reset;
// wires                                               
wire [7:0]  OutputRandomNumber;
wire [6:0]  out1;
wire [6:0]  out2;
wire [6:0]  out3;
wire [6:0]  out4;
wire [6:0]  out5;
wire [6:0]  out6;
wire [6:0]  out7;
wire [6:0]  out8;
wire [31:0]  outputNumber;
wire [31:0]  outputReg3;
wire [31:0]  result;

// assign statements (if any)                          
Cpu i1 (
// port map - connection between master ports and signals/registers   
	.OutputRandomNumber(OutputRandomNumber),
	.RandomNumber(RandomNumber),
	.clk(clk),
	.myreset(myreset),
	.out1(out1),
	.out2(out2),
	.out3(out3),
	.out4(out4),
	.out5(out5),
	.out6(out6),
	.out7(out7),
	.out8(out8),
	.outputNumber(outputNumber),
	.outputReg3(outputReg3),
	.reset(reset),
	.result(result)
);
always #2 clk=~clk; 
initial
begin
clk=0;reset=1;myreset=0;RandomNumber=8'b00000101;
//m=32'b00000000000000000000000000000101;
#40	myreset=1;
#80 reset=0;
#20 reset=1;myreset=0;                                                                                                     
end                                                    
endmodule

