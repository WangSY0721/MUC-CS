module Pc(
	input clk,
	input reset,
	input Pcwre,
	input	[31:0]nextPc,
	output reg [31:0]curPc,

	output reg [3:0] output1
);
initial
begin
	curPc=0;
	if(!clk)
		output1=4'b1111
	else
		output1=0;
end
always@(posedge clk or negedge reset)
begin
	if(!reset)
		begin
			curPc=0;
		end
	else
		begin
			//为1时说明继续
			if(Pcwre)
				curPc=nextPc+4;
			else
				curPc=curPc;
		end
end
endmodule