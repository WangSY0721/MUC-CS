module ALU(
	input aluw,
	input [4:0] ALUfunc,
	input signed [31:0] rs_data,
	input signed [31:0] rt_data,
	output reg beq,
	output reg bne,
	output signed [31:0] result,
	output signed [31:0] a,
	output signed [31:0] b
);
reg signed [31:0] A;
reg signed [31:0] B;
reg signed [63:0] ex_result;
reg signed [31:0] hi;
reg signed [31:0] lo;
reg signed [31:0] r;
initial
begin
	r <= 0;
	ex_result <= 0;
	hi <= 0;
	lo <= 0;
end
always @ *
begin
	beq <= 0;
	bne <= 0;
	if(aluw)
		begin
			A <= rs_data;
			B <= rt_data;
		end
	if(ALUfunc == 1 || ALUfunc == 14 || ALUfunc == 18 || ALUfunc == 19)  //add,addi,lw,sw
		r <= A + B;
	else if (ALUfunc == 2)                      //sub
		r <= A - B;
	else if (ALUfunc == 3 || ALUfunc == 15)     //and,andi
		r <= A & B;
	else if (ALUfunc == 4 || ALUfunc == 16)     //or,ori
		r <= A | B;
	else if (ALUfunc == 5 || ALUfunc == 17)     //xor,xori
		r <= A ^ B;
	else if (ALUfunc == 6 || ALUfunc == 22)        //slt,slti
		r <= A < B ? 1:0;
	else if (ALUfunc == 7)                      //sll
		r <= B << A;
	else if (ALUfunc == 8)                      //srl
		r <= B >> A;
	else if (ALUfunc == 9)                   //mlut
		begin
			ex_result <= A * B;
			hi <= ex_result[63:32];
			lo <= ex_result[31:0];
		end
	else if (ALUfunc == 10)                 //mflo
		r = lo;
	else if (ALUfunc == 11)             //mfhi
		r = hi;
	else if (ALUfunc == 20) 
		beq <= A == B ? 1:0;
	else if (ALUfunc == 21)
		bne <= A == B ? 0:1;
end
assign result = r;
assign a = A;
assign b = B;
endmodule